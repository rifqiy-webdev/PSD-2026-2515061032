class StackArray:
    def __init__(self, max_size=100):
        self.MAX = max_size
        self.st = [None] * self.MAX
        self.top_idx = -1

    def is_empty(self):
        return self.top_idx == -1

    def is_full(self):
        return self.top_idx == self.MAX - 1

    def push(self, x):
        if self.is_full():
            print("Stack penuh")
            return

        self.top_idx += 1
        self.st[self.top_idx] = x

    def pop(self):
        if self.is_empty():
            return None

        data = self.st[self.top_idx]
        self.top_idx -= 1
        return data

    def display(self):
        if self.is_empty():
            print("Kosong")
            return

        for i in range(self.top_idx, -1, -1):
            print(self.st[i], end=" | ")
        print()


def main():

    history = StackArray()

    redo_stack = StackArray()

    pilih = 0

    while pilih != 6:

        print("\n=== MENU UNDO / REDO ===")
        print("1. Tambah Aksi")
        print("2. Undo")
        print("3. Redo")
        print("4. Lihat History")
        print("5. Lihat Redo")
        print("6. Keluar")

        try:
            pilih = int(input("Pilih menu: "))
        except ValueError:
            print("Input harus angka")
            continue

        if pilih == 1:

            aksi = input("Masukkan aksi: ")

            history.push(aksi)

            redo_stack = StackArray()

            print(f"Aksi '{aksi}' berhasil ditambahkan")

        elif pilih == 2:

            aksi = history.pop()

            if aksi is None:
                print("Tidak ada aksi untuk di-undo")

            else:
                redo_stack.push(aksi)

                print(f"Undo aksi: {aksi}")

        elif pilih == 3:

            aksi = redo_stack.pop()

            if aksi is None:
                print("Tidak ada aksi untuk di-redo")

            else:
                history.push(aksi)

                print(f"Redo aksi: {aksi}")

        elif pilih == 4:

            print("\nHistory Aksi:")
            history.display()

        elif pilih == 5:

            print("\nRedo Stack:")
            redo_stack.display()

        elif pilih == 6:

            print("Program selesai")

        else:
            print("Pilihan tidak valid")


if __name__ == "__main__":
    main()